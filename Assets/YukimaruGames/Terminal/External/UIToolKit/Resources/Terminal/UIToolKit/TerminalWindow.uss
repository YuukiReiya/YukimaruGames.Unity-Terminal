.terminal-window {
    position: absolute;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.terminal-log-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
}

.terminal-input-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding: 2px 4px;
}

.terminal-prompt-label {
    color: rgb(0, 255, 0);
    margin-right: 4px;
    -unity-text-align: middle-left;
}

.terminal-input-field {
    flex-grow: 1;
}

.terminal-submit-button {
    margin-left: 4px;
}

.terminal-launcher-container {
    position: absolute;
    flex-direction: row;
}

.terminal-launcher-button {
    min-width: 24px;
}

#log-line {
    flex-direction: row;
    flex-shrink: 0;
}

#log-line-message {
    flex-grow: 1;
    white-space: normal;
}
